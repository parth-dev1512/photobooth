# SMTP credentials used to email the finished photostrip.
# Gmail example: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Photobooth <your-address@gmail.com>"

# Must exactly match the printer name shown in Windows "Printers & scanners".
PRINTER_NAME=Canon LBP2900

# Physical sheet the strip is printed onto and cut from: LETTER or A4.
# Must be a size the printer driver actually supports (check with the
# printer's properties dialog) or the print job silently falls back to a
# different default sheet and the strip's position/margins will be off.
PRINT_PAGE_SIZE=LETTER

# Spotify Developer app credentials (developer.spotify.com/dashboard), used
# to search for the entered song and fetch its real scannable Spotify code.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

PORT=3000
